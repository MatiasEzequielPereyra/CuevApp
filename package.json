{
  "name": "cuevapp",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.14.0 <23",
    "npm": ">=10 <11"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test:docs": "node --test tests/documents.test.mjs",
    "test": "npm run test:docs && playwright test",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm run typecheck && npm run build && npm test",
    "verify:sources": "node scripts/verify-sources.mjs",
    "verify:security": "node scripts/security-review.mjs"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "typescript": "6.0.3"
  }
}
