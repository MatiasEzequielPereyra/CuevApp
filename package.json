{
  "name": "cuevapp",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.14.0 <23",
    "npm": ">=10 <11"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test:docs": "node --test tests/documents.test.mjs",
    "test": "npm run test:docs && npm run test:notifications:core && npm run test:notifications:dispatcher && npm run test:notifications:worker && npm run test:notifications:inbox && npm run test:notifications:brevo && npm run test:notifications:webpush && npm run test:notifications:push-subscription && npm run test:notifications:push-route && npm run test:notifications:worker-endpoint && npm run test:routines:model && node --test tests/due-date-preview.test.mjs tests/billing-api.test.mjs tests/payments-money.test.mjs tests/reconciliation-transport.test.mjs && npm run test:receipts && playwright test",
    "test:routines:model": "node --experimental-strip-types --test experiments/cueva-006c-local/model.test.mjs",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm run typecheck && npm run build && npm test",
    "verify:sources": "node scripts/verify-sources.mjs",
    "verify:security": "node scripts/security-review.mjs",
    "verify:source-manifest": "node scripts/verify-source-manifest-unchanged.mjs",
    "test:receipts": "node --expose-gc --test tests/receipts-file.test.mjs",
    "test:notifications:core": "node --experimental-strip-types --test tests/notifications-core.test.mjs",
    "test:notifications:dispatcher": "node --experimental-strip-types --test tests/notifications-dispatcher.test.mjs",
    "test:notifications:worker": "node --experimental-strip-types --test tests/notifications-worker.test.mjs",
    "test:notifications:inbox": "node --experimental-strip-types --test tests/notifications-inbox-provider.test.mjs tests/notifications-inbox-route.test.mjs",
    "test:notifications:brevo": "node --experimental-strip-types --test tests/notifications-brevo-provider.test.mjs",
    "test:notifications:webpush": "node --experimental-strip-types --test tests/notifications-web-push-provider.test.mjs",
    "test:notifications:push-subscription": "node --experimental-strip-types --test tests/notifications-push-subscription.test.mjs",
    "test:notifications:worker-endpoint": "node --experimental-strip-types --test tests/notifications-worker-endpoint-auth.test.mjs",
    "test:notifications:push-route": "node --experimental-strip-types --test tests/notifications-push-route-http.test.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "next": "16.4.3",
    "pdf-lib": "1.17.1",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/pg": "8.20.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "typescript": "6.0.3"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  }
}
