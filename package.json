{
  "name": "cuevapp",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.14.0 <23",
    "npm": ">=10 <11"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test:docs": "node --test tests/documents.test.mjs",
    "test": "npm run test:docs && npm run test:routines:model && npm run test:receipts && playwright test",
    "test:receipts": "node --expose-gc --test tests/receipts-file.test.mjs",
    "test:routines:model": "node --experimental-strip-types --test experiments/cueva-006c-local/model.test.mjs",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm run typecheck && npm run build && npm test",
    "verify:sources": "node scripts/verify-sources.mjs",
    "verify:security": "node scripts/security-review.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "next": "16.4.3",
    "pdf-lib": "1.17.1",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/pg": "8.20.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "typescript": "6.0.3"
  }
}

